RewriteEngine On
DirectoryIndex router.php

# Block direct access to internal PHP tree
RewriteRule ^pages/ - [F,L]

# Static assets
RewriteRule ^assets/ - [L]

# Other static file types
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|mjs|map|svg|png|jpe?g|gif|webp|woff2?|ttf|eot|ico|avif|pdf)$ - [L,NC]

# router.php only
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^router\.php$ - [L]

# Everything else → front controller (clean URLs)
RewriteRule ^ router.php [L,QSA]
